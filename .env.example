# Live Help Agent (api/agent.ts). Copy to .env.local for `npm run dev`; set in Vercel for deploys.
# Without a key the app uses the scripted demo engine.
ANTHROPIC_API_KEY=
# "off" sends every visitor to the demo engine (kill switch).
AGENT_LIVE=
# Daily spend cap in USD per function instance (default 5).
AGENT_DAILY_BUDGET_USD=
